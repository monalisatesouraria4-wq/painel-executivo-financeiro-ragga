# Copie para .env.local e preencha com as credenciais do projeto Supabase.
# Nunca commitar .env.local (já está no .gitignore).

# Connection string do Postgres (Supabase > Project Settings > Database)
DATABASE_URL=

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas para uso server-side (nunca expor com prefixo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Exclusões da sincronização de bases (comando, tela e Server Action): OPT-IN em todos os ambientes.
# Só o valor exato 1 libera; ausente/0/qualquer outro = BLOQUEADO. Mantenha 0 em qualquer ambiente ligado a um banco real.
SINCRONIZACAO_EXCLUSOES_HABILITADAS=0

# Pasta de backup das sincronizações (exigida para excluir; em produção/serverless o disco é efêmero)
# SINCRONIZACAO_BACKUP_DIR=
